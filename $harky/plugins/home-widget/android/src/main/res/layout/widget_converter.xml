<?xml version="1.0" encoding="utf-8"?>
<!--
  Conversor 2x2 — son tres cifras, no necesitaban 3x3.

  Cambios frente al diseno anterior:
   - Fuera las banderas dentro de cajas con borde (tres tarjetas anidadas para
     mostrar tres numeros) y la fila "Updated ...".
   - La divisa base pasa al encabezado ("1 unidad en DOP") en vez de un chip.
   - Los codigos (USD / EUR / COP) a la izquierda y las cifras alineadas a la
     derecha, para que se lean en columna.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_conv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <TextView
        android:id="@+id/widget_conv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:letterSpacing="0.11"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#6E7688"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_conv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty_state"
        android:textColor="#6E7688"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Fila 1 -->
    <LinearLayout
        android:id="@+id/widget_conv_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_conv_code_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#99A1B3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_conv_value_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#F2F5FB"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fila 2 -->
    <LinearLayout
        android:id="@+id/widget_conv_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_conv_code_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#99A1B3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_conv_value_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#F2F5FB"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fila 3 -->
    <LinearLayout
        android:id="@+id/widget_conv_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_conv_code_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#99A1B3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_conv_value_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#F2F5FB"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
