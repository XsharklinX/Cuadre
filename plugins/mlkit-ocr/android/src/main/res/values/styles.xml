<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema de la pantalla de cámara: pantalla completa, fondo negro (no el
         splash del tema de la app), status/nav bars translúcidas para que el
         preview llegue a los bordes. -->
    <style name="Theme.MlkitScanner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Sin `statusBarColor`, `navigationBarColor` ni el modo `shortEdges`:
             son los parametros obsoletos desde Android 15 que Play Console
             avisaba. El borde a borde lo pone `enableEdgeToEdge()` en
             ScannerActivity, y los margenes los aplica `applyEdgeToEdgeInsets`. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
