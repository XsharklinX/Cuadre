<?xml version="1.0" encoding="utf-8"?>
<!--
  Superficie del widget en Android 12+.

  Igual que la normal salvo por el RADIO: usa el que el sistema expone para
  fondos de widget. Cada launcher recorta con su propio radio, y una esquina
  de 24dp fija dentro de un recorte de 28dp deja una linea de fondo asomando
  por el borde — el detalle que delata a un widget como ajeno al sistema.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/widget_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_stroke" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
