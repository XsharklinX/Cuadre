<?xml version="1.0" encoding="utf-8"?>
<!--
  MATERIAL YOU (Android 12+), claro.

  El widget toma los colores del FONDO DE PANTALLA del usuario. Es la
  diferencia entre un widget que parece parte del telefono y uno que parece
  pegado encima, y es lo que separa un widget de 2025 de uno de 2019.

  Los `system_*` los genera Android a partir del fondo; no hay que elegirlos.
-->
<resources>
    <color name="widget_surface">@android:color/system_accent2_50</color>
    <color name="widget_stroke">@android:color/system_accent2_100</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_dim">@android:color/system_neutral2_700</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>
    <color name="widget_on_accent">@android:color/system_accent1_0</color>
    <color name="widget_track">@android:color/system_accent2_100</color>

    <color name="widget_fab_top">@android:color/system_accent1_400</color>
    <color name="widget_fab_mid">@android:color/system_accent3_500</color>
    <color name="widget_fab_bottom">@android:color/system_accent1_700</color>
    <color name="widget_fab_edge">@android:color/system_accent1_100</color>
    <color name="widget_fab_ink">#FFFFFF</color>
</resources>
