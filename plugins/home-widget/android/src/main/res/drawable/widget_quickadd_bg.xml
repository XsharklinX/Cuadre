<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del acceso rápido 1x1. Antes era un azul plano de 2 paradas: se veía
  chato, como un rectángulo cualquiera. Ahora es un botón: degradado vertical
  "iluminado desde arriba" (claro arriba → azul de marca → azul profundo) más
  un borde translúcido que le da canto de vidrio. Es el mismo lenguaje del FAB
  "+" que vive dentro de la app, para que se reconozca como "agregar".

  El radio (16dp sobre un cuadrado de 58dp, ~28%) imita el "squircle" con el
  que los launchers recortan los iconos de apps. El 22dp anterior salía
  demasiado redondo y lo delataba como algo ajeno a la rejilla de iconos.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_fab_top"
        android:centerColor="@color/widget_fab_mid"
        android:endColor="@color/widget_fab_bottom" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_fab_edge" />
    <corners android:radius="16dp" />
</shape>
